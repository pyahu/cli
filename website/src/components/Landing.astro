---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "./Icon.astro";
import { ui, experience, type Lang } from "../i18n/landing";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const x = experience[lang];

const base = lang === "en" ? "/en" : "";
const docs = `${base}/docs`;
const installFoot = t.install.foot.replace("$DOCS", docs);
---

<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description} current="home">
  <section class="hero">

    <div class="hero-grid">
      <div class="hero-content">
        <p class="eyebrow"><span class="signal" />PYAHU CLI <span class="eyebrow-divider">/</span> COMMUNITY</p>
        <h1>{t.hero.titleLead} <span>{t.hero.titleAccent}</span></h1>
        <p class="hero-copy">{t.hero.copy}</p>
        <div class="hero-actions">
          <a class="button primary" href="#instalar">{t.hero.ctaStart}<Icon name="arrow" size={18} /></a>
          <a class="hero-docs" href={docs}>{t.hero.ctaCommands}<Icon name="arrow" size={16} /></a>
        </div>
      </div>

      <figure class="terminal" aria-label={t.hero.terminalAlt}>
        <div class="terminal-bar">
          <span class="terminal-session"><Icon name="terminal" size={18} />pyahu-local</span>
          <span class="terminal-title">{x.sample}</span>
        </div>
        <pre class="terminal-body"><code><span class="t-prompt">$</span> <span class="t-cmd">pyahu up</span></code></pre>
        <ul class="terminal-summary">{t.hero.summary.map(line => <li><span aria-hidden="true">✓</span>{line}</li>)}</ul>
        <p class="terminal-result"><span class="signal" />{t.hero.result}</p>
        <figcaption>{t.hero.example}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section steps-section" id="quickstart" aria-labelledby="steps-title">
    <div class="section-heading">
      <p class="eyebrow">{t.steps.eyebrow}</p>
      <h2 id="steps-title">{t.steps.title}</h2><p class="section-lead">{x.requirement}</p>
      <ul class="workflow-principles">{x.principles.map((item, i) => <li><Icon name={(["contract", "layers", "review"] as const)[i]} size={18} />{item}</li>)}</ul>
    </div>
    <div class="steps-grid">
      {
        t.steps.items.map((step) => (
          <article class="step-card">
            <span class="step-number">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <div class="step-code">
              <span>$</span>
              <code>{step.code}</code>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section id="services" class="section services-section" aria-labelledby="services-title">
    <div class="section-heading">
      <p class="eyebrow">{t.services.eyebrow}</p>
      <h2 id="services-title">{t.services.title}</h2>
      <p class="section-lead">{t.services.lead}</p>
    </div>
    <div class="service-grid">
      {
        t.services.items.map((service) => (
          <article class={`service-card accent-${service.accent}`}>
            <div class="service-top">
              <Icon name={service.name === "ZITADEL" ? "shield" : service.name === "Kafka UI" ? "review" : service.name.includes("Connect") ? "route" : "layers"} size={23} />
              <h3>{service.name}</h3>
            </div>
            <p>{service.role}</p>
            <code class="service-endpoint">{service.endpoint}</code>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section split-section platform-section" aria-labelledby="platform-title">
    <div class="split-copy">
      <p class="eyebrow">{t.platform.eyebrow}</p>
      <h2 id="platform-title">{t.platform.title}</h2>
      <p set:html={t.platform.copy} />
      <a class="text-link" href={docs}>{t.platform.link}</a>
    </div>
    <pre class="code-panel"><code><span class="t-prompt">$</span> export KUBECONFIG="$(pyahu kubeconfig)"
<span class="t-prompt">$</span> <span class="t-cmd">kubectl</span> get ingress,pvc,cm,secret -n pyahu-local-dev
ingress/zitadel         <span class="t-dim">zitadel.localhost</span>
ingress/kafka-ui        <span class="t-dim">kafka-ui.localhost</span>
pvc/postgres-data       <span class="t-ok">Bound</span>
configmap/rabbitmq-config
secret/pyahu-local-tls  <span class="t-dim">kubernetes.io/tls</span></code></pre>
  </section>

  <section class="section install-section" id="instalar" aria-labelledby="install-title">
    <div class="section-heading">
      <p class="eyebrow">{t.install.eyebrow}</p>
      <h2 id="install-title">{t.install.title}</h2>
      <p class="section-lead">{t.install.lead}</p>
    </div>

    <div class="install-widget" data-install>
      <div class="install-tabs" role="tablist" aria-label="Pyahu CLI">
        <button class="install-tab is-active" role="tab" aria-selected="true" id="install-tab-script" aria-controls="install-panel-script" tabindex="0" data-tab="script">Script</button>
        <button class="install-tab" role="tab" aria-selected="false" id="install-tab-go" aria-controls="install-panel-go" tabindex="-1" data-tab="go">Go</button>
        <button class="install-tab" role="tab" aria-selected="false" id="install-tab-release" aria-controls="install-panel-release" tabindex="-1" data-tab="release">Releases</button>
      </div>
      <div class="install-panels">
        <div class="install-panel is-active" role="tabpanel" id="install-panel-script" aria-labelledby="install-tab-script" tabindex="0" data-panel="script" data-copy-widget>
          <pre><code><span class="t-comment">{t.install.comments.script}</span>
<span class="t-prompt">$</span> <span data-copy-command>curl -fsSL https://cli.pyahu.io/install.sh | sh</span>
<span class="t-prompt">$</span> pyahu --version</code></pre>
          <button type="button" class="copy-button install-copy" data-copy><Icon name="contract" size={17} />{x.copy}</button>
          <span class="copy-status" data-copy-status role="status" data-success={x.copied} data-error={x.copyError}></span>
        </div>
        <pre class="install-panel" role="tabpanel" id="install-panel-go" aria-labelledby="install-tab-go" tabindex="0" data-panel="go" hidden><code><span class="t-comment">{t.install.comments.go}</span>
<span class="t-prompt">$</span> go install github.com/pyahu/cli/cmd/pyahu@latest</code></pre>
        <pre class="install-panel" role="tabpanel" id="install-panel-release" aria-labelledby="install-tab-release" tabindex="0" data-panel="release" hidden><code><span class="t-comment">{t.install.comments.release}</span>
<span class="t-prompt">$</span> tar -xzf pyahu_Linux_x86_64.tar.gz
<span class="t-prompt">$</span> sudo mv pyahu /usr/local/bin/</code></pre>
      </div>
    </div>
    <p class="install-foot" set:html={installFoot} /><a class="text-link release-link" href="https://github.com/pyahu/cli/releases">{x.release}<Icon name="arrow" size={16} /></a>
  </section>

  <section class="section split-section tls-section" aria-labelledby="tls-title">
    <div class="split-copy">
      <p class="eyebrow">{t.tls.eyebrow}</p>
      <h2 id="tls-title">{t.tls.title}</h2>
      <p set:html={t.tls.copy} />
      <a class="text-link" href={`${docs}/certificados`}>{t.tls.link}</a>
    </div>
    <pre class="code-panel"><code><span class="t-prompt">$</span> pyahu certs status
<span class="t-dim">CA status:  </span> <span class="t-ok">valid</span>
<span class="t-dim">host trust: </span> not trusted

<span class="t-prompt">$</span> pyahu certs trust
<span class="t-dim">trusted local CA</span>

<span class="t-prompt">$</span> curl https://zitadel.localhost/debug/healthz
<span class="t-ok">ok</span></code></pre>
  </section>

  <section class="section split-section split-reverse cdc-section" aria-labelledby="cdc-title">
    <div class="split-copy">
      <p class="eyebrow">{t.cdc.eyebrow}</p>
      <h2 id="cdc-title">{t.cdc.title}</h2>
      <p set:html={t.cdc.copy} />
      <a class="text-link" href={`${docs}/kafka-connect-debezium`}>{t.cdc.link}</a>
    </div>
    <pre class="code-panel"><code><span class="t-comment">services:</span>
  <span class="t-key">kafkaConnect:</span>
    <span class="t-key">enabled:</span> true
    <span class="t-key">connectors:</span>
      - <span class="t-key">name:</span> app-cdc
        <span class="t-key">type:</span> source
        <span class="t-key">kind:</span> debezium.postgres
        <span class="t-key">tables:</span>
          <span class="t-key">include:</span>
            - public.orders</code></pre>
  </section>

  <section class="section capabilities-section" aria-labelledby="cap-title">
    <div class="section-heading">
      <p class="eyebrow">{t.capabilities.eyebrow}</p>
      <h2 id="cap-title">{t.capabilities.title}</h2>
    </div>
    <div class="capability-grid">
      {
        t.capabilities.items.map((item) => (
          <article class="capability-card"><Icon name="check" size={23} />
            <h3>{item.label}</h3>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section commands-section" aria-labelledby="commands-title">
    <div class="section-heading">
      <p class="eyebrow">{t.commands.eyebrow}</p>
      <h2 id="commands-title">{t.commands.title}</h2>
    </div>
    <div class="command-grid">
      {
        t.commands.groups.map((group) => (
          <article class="command-card">
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((item) => (
                <li><code>{item}</code></li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
    <a class="button secondary command-cta" href={`${docs}/comandos`}>{t.commands.cta}</a>
  </section>

  <section class="ecosystem-section"><div class="container ecosystem-layout"><div><p class="eyebrow">{x.ecosystem.eyebrow}</p><h2>{x.ecosystem.title}</h2><p>{x.ecosystem.body}</p><a class="text-link" href={lang === "en" ? "https://pyahu.io" : "https://pyahu.io/pt"}>{x.ecosystem.action}<Icon name="arrow" size={18} /></a></div><div class="ecosystem-flow"><a href="https://github.com/pyahu/toolchain"><Icon name="code" /><span><small>{x.ecosystem.prepare}</small>Pyahu Toolchain</span><Icon name="arrow" size={16} /></a><div class="ecosystem-current"><Icon name="terminal" /><span><small>{x.ecosystem.local}</small>Pyahu CLI</span></div><a href={lang === "en" ? "https://pyahu.io/#adoption" : "https://pyahu.io/pt#adoption"}><Icon name="layers" /><span><small>{x.ecosystem.operate}</small>Foundation + Cloud</span><Icon name="arrow" size={16} /></a><p>{x.ecosystem.soon}</p></div></div></section>

  <section class="final-cta" aria-labelledby="final-title">
    <p class="eyebrow">{t.finalCta.eyebrow}</p>
    <h2 id="final-title">{t.finalCta.title}</h2>
    <div class="hero-actions center">
      <a class="button primary" href={`${docs}/instalacao`}>{t.finalCta.ctaInstall}</a>
      <a class="button secondary" href={docs}>{t.finalCta.ctaDocs}</a>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLElement>("[data-install]").forEach((widget) => {
      const tabs = Array.from(widget.querySelectorAll<HTMLButtonElement>("[data-tab]"));
      const panels = widget.querySelectorAll<HTMLElement>("[data-panel]");
      function activate(tab: HTMLButtonElement) {
        tabs.forEach(t => { const active = t === tab; t.classList.toggle("is-active", active); t.setAttribute("aria-selected", String(active)); t.tabIndex = active ? 0 : -1; });
        panels.forEach(panel => { const active = panel.dataset.panel === tab.dataset.tab; panel.classList.toggle("is-active", active); panel.hidden = !active; });
      }
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activate(tab));
        tab.addEventListener("keydown", (event) => {
          let next = index;
          if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
          else if (event.key === "ArrowLeft") next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = tabs.length - 1;
          else return;
          event.preventDefault(); activate(tabs[next]); tabs[next].focus();
        });
      });
    });
    document.querySelectorAll<HTMLElement>("[data-copy-widget]").forEach(widget => {
      const button = widget.querySelector<HTMLButtonElement>("[data-copy]");
      const status = widget.querySelector<HTMLElement>("[data-copy-status]");
      const command = widget.querySelector<HTMLElement>("[data-copy-command]");
      button?.addEventListener("click", async () => {
        if (!status || !command) return;
        try { await navigator.clipboard.writeText(command.textContent?.trim() ?? ""); status.textContent = status.dataset.success ?? ""; }
        catch { status.textContent = status.dataset.error ?? ""; status.classList.remove("sr-only"); }
      });
    });
  </script>
</BaseLayout>
