---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "./Icon.astro";
import { content as t } from "../i18n/landing";

const docs = "/docs";
---

<BaseLayout title={t.meta.title} description={t.meta.description} current="home">
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-content">
        <p class="eyebrow"><span class="signal" />{t.hero.eyebrow}</p>
        <h1>{t.hero.title} <span>{t.hero.accent}</span></h1>
        <p class="hero-copy">{t.hero.copy}</p>
        <div class="hero-actions">
          <a class="button primary" href="#install">{t.hero.primary}<Icon name="arrow" size={18} /></a>
          <a class="button quiet" href={`${docs}/configuration`}>{t.hero.secondary}</a>
        </div>
      </div>

      <div class="quickstart" id="quickstart" aria-labelledby="quickstart-title">
        <div class="panel-bar"><span></span><span></span><span></span><code>project/</code></div>
        <h2 id="quickstart-title">{t.quickstart.title}</h2>
        <ol>
          {t.quickstart.items.map((step) => (
            <li>
              <span class="step-number">{step.number}</span>
              <div><h3>{step.title}</h3><p>{step.text}</p><pre><code><span>$</span> {step.command}</code></pre></div>
            </li>
          ))}
        </ol>
        <p class="requirement">{t.quickstart.requirement}</p>
      </div>
    </div>
  </section>

  <section id="why" class="section fit-section" aria-labelledby="fit-title">
    <div class="section-heading">
      <p class="eyebrow">{t.fit.eyebrow}</p>
      <h2 id="fit-title">{t.fit.title}</h2>
      <p class="section-lead">{t.fit.lead}</p>
    </div>
    <div class="point-grid">
      {t.fit.items.map((item) => (
        <article class="point-card"><Icon name={item.icon} size={24} /><h3>{item.title}</h3><p>{item.text}</p></article>
      ))}
    </div>
    <aside class="honest-note"><strong>Keep it simple.</strong> {t.fit.honest}</aside>
  </section>

  <section id="services" class="section services-section" aria-labelledby="services-title">
    <div class="section-heading">
      <p class="eyebrow">{t.services.eyebrow}</p>
      <h2 id="services-title">{t.services.title}</h2>
      <p class="section-lead">{t.services.lead}</p>
    </div>
    <div class="service-list">
      {t.services.items.map((service) => (
        <article class="service-row">
          <h3>{service.name}</h3><p>{service.role}</p><code>{service.endpoint}</code>
        </article>
      ))}
    </div>
    <p class="resource-note"><Icon name="review" size={20} />{t.services.resourceNote}</p>
  </section>

  <section class="section split-section" aria-labelledby="control-title">
    <div class="split-copy">
      <p class="eyebrow">{t.control.eyebrow}</p>
      <h2 id="control-title">{t.control.title}</h2>
      <p>{t.control.copy}</p>
      <a class="text-link" href={`${docs}/commands`}>{t.control.link}<Icon name="arrow" size={16} /></a>
    </div>
    <pre class="code-panel"><code><span class="t-prompt">$</span> pyahu services

SERVICE   STATUS  VERSION     ENDPOINTS
postgres  <span class="t-ok">ready</span>   18.4        localhost:5432
redis     <span class="t-ok">ready</span>   8.1-alpine  localhost:6379
kafka     <span class="t-ok">ready</span>   4.3.0       localhost:9092

<span class="t-prompt">$</span> export KUBECONFIG="$(pyahu kubeconfig)"
<span class="t-prompt">$</span> kubectl get pods -n pyahu-local-dev
postgres-0     <span class="t-ok">1/1 Running</span>
redis-0        <span class="t-ok">1/1 Running</span></code></pre>
  </section>

  <section class="section safeguards-section" aria-labelledby="safeguards-title">
    <div class="section-heading">
      <p class="eyebrow">{t.safeguards.eyebrow}</p>
      <h2 id="safeguards-title">{t.safeguards.title}</h2>
    </div>
    <div class="point-grid">
      {t.safeguards.items.map((item) => (
        <article class="point-card"><Icon name={item.icon} size={24} /><h3>{item.title}</h3><p>{item.text}</p></article>
      ))}
    </div>
  </section>

  <section class="section split-section connect-section" aria-labelledby="connect-title">
    <div class="split-copy">
      <p class="eyebrow">{t.connect.eyebrow}</p>
      <h2 id="connect-title">{t.connect.title}</h2>
      <p>{t.connect.copy}</p>
      <a class="text-link" href={`${docs}/kafka-connect-debezium`}>{t.connect.link}<Icon name="arrow" size={16} /></a>
    </div>
    <pre class="code-panel"><code><span class="t-key">services:</span>
  <span class="t-key">kafkaConnect:</span>
    <span class="t-key">connectors:</span>
      - <span class="t-key">name:</span> app-cdc
        <span class="t-key">kind:</span> debezium.postgres
        <span class="t-key">database:</span> app
        <span class="t-key">tables:</span>
          <span class="t-key">include:</span>
            - public.orders</code></pre>
  </section>

  <section class="section install-section" id="install" aria-labelledby="install-title">
    <div class="section-heading">
      <p class="eyebrow">{t.install.eyebrow}</p>
      <h2 id="install-title">{t.install.title}</h2>
      <p class="section-lead">{t.install.lead}</p>
    </div>
    <div class="install-widget" data-install>
      <div class="install-tabs" role="tablist" aria-label="Install Pyahu CLI">
        <button class="install-tab is-active" role="tab" aria-selected="true" id="install-tab-script" aria-controls="install-panel-script" tabindex="0" data-tab="script">Script</button>
        <button class="install-tab" role="tab" aria-selected="false" id="install-tab-mise" aria-controls="install-panel-mise" tabindex="-1" data-tab="mise">mise</button>
        <button class="install-tab" role="tab" aria-selected="false" id="install-tab-go" aria-controls="install-panel-go" tabindex="-1" data-tab="go">Go</button>
      </div>
      <div class="install-panel" role="tabpanel" id="install-panel-script" aria-labelledby="install-tab-script" tabindex="0" data-panel="script" data-copy-widget>
        <pre><code><span class="t-comment">{t.install.comments.script}</span>
<span class="t-prompt">$</span> <span data-copy-command>curl -fsSL https://cli.pyahu.io/install.sh | sh</span>
<span class="t-prompt">$</span> pyahu doctor</code></pre>
        <button type="button" class="copy-button" data-copy><Icon name="contract" size={17} />{t.actions.copy}</button>
        <span class="copy-status" data-copy-status role="status" data-success={t.actions.copied} data-error={t.actions.copyError}></span>
      </div>
      <pre class="install-panel" role="tabpanel" id="install-panel-mise" aria-labelledby="install-tab-mise" tabindex="0" data-panel="mise" hidden><code><span class="t-comment">{t.install.comments.mise}</span>
<span class="t-prompt">$</span> mise use --pin "github:pyahu/cli@latest"
<span class="t-prompt">$</span> mise install</code></pre>
      <pre class="install-panel" role="tabpanel" id="install-panel-go" aria-labelledby="install-tab-go" tabindex="0" data-panel="go" hidden><code><span class="t-comment">{t.install.comments.go}</span>
<span class="t-prompt">$</span> go install github.com/pyahu/cli/cmd/pyahu@latest</code></pre>
    </div>
    <div class="install-links"><a class="text-link" href={`${docs}/installation`}>{t.install.details}<Icon name="arrow" size={16} /></a><a class="text-link" href="https://github.com/pyahu/cli/releases">{t.install.release}<Icon name="github" size={16} /></a></div>
  </section>

  <section class="final-cta" aria-labelledby="final-title">
    <p class="eyebrow">{t.final.eyebrow}</p>
    <h2 id="final-title">{t.final.title}</h2>
    <div class="hero-actions center"><a class="button primary" href={`${docs}/installation`}>{t.final.primary}</a><a class="button quiet" href={docs}>{t.final.secondary}</a></div>
  </section>

  <script>
    document.querySelectorAll<HTMLElement>("[data-install]").forEach((widget) => {
      const tabs = Array.from(widget.querySelectorAll<HTMLButtonElement>("[data-tab]"));
      const panels = widget.querySelectorAll<HTMLElement>("[data-panel]");
      function activate(tab: HTMLButtonElement) {
        tabs.forEach((item) => { const active = item === tab; item.classList.toggle("is-active", active); item.setAttribute("aria-selected", String(active)); item.tabIndex = active ? 0 : -1; });
        panels.forEach((panel) => { const active = panel.dataset.panel === tab.dataset.tab; panel.hidden = !active; });
      }
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activate(tab));
        tab.addEventListener("keydown", (event) => {
          let next = index;
          if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
          else if (event.key === "ArrowLeft") next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = tabs.length - 1;
          else return;
          event.preventDefault(); activate(tabs[next]); tabs[next].focus();
        });
      });
    });
    document.querySelectorAll<HTMLElement>("[data-copy-widget]").forEach((widget) => {
      const button = widget.querySelector<HTMLButtonElement>("[data-copy]");
      const status = widget.querySelector<HTMLElement>("[data-copy-status]");
      const command = widget.querySelector<HTMLElement>("[data-copy-command]");
      button?.addEventListener("click", async () => {
        if (!status || !command) return;
        try { await navigator.clipboard.writeText(command.textContent?.trim() ?? ""); status.textContent = status.dataset.success ?? ""; }
        catch { status.textContent = status.dataset.error ?? ""; }
      });
    });
  </script>
</BaseLayout>
