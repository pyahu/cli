---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { ui, experience, type Lang } from "../i18n/landing";
interface Props { lang?: Lang; title?: string; description?: string; current?: "home" | "docs"; }
const { lang = "pt-BR" } = Astro.props;
const t = ui[lang]; const x = experience[lang];
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const home = lang === "en" ? "/en/" : "/";
const docs = lang === "en" ? "/en/docs" : "/docs";
const platform = lang === "en" ? "https://pyahu.io" : "https://pyahu.io/pt";
const canonical = new URL(home, "https://cli.pyahu.io");
const nav = [{ href: "#services", label: x.services }, { href: "#quickstart", label: x.workflow }, { href: docs, label: t.nav.docs }];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} /><meta name="theme-color" content="#03070d" /><title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <meta property="og:image" content="/pyahu-terminal.svg" /><meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="pt-BR" href="https://cli.pyahu.io/" /><link rel="alternate" hreflang="en" href="https://cli.pyahu.io/en/" />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === "en" ? "Skip to content" : "Pular para o conteúdo"}</a>
    <header class="site-header container" id="top">
      <a class="brand" href={home} aria-label="Pyahu CLI"><img src="/logo.svg" alt="" width="34" height="34" /><span>pyahu<span class="brand-divider">/</span><span class="brand-product">cli</span></span></a>
      <nav class="desktop-nav" aria-label="Pyahu CLI">{nav.map(n => <a href={n.href}>{n.label}</a>)}</nav>
      <div class="header-actions"><div class="lang-switch" aria-label="Idioma / Language"><a href="/en/" lang="en" hreflang="en" aria-current={lang === "en" ? "page" : undefined}>EN</a><span>/</span><a href="/" lang="pt-BR" hreflang="pt-BR" aria-current={lang === "pt-BR" ? "page" : undefined}>PT</a></div><a class="nav-cta" href="#instalar">{x.install}<Icon name="arrow" size={16} /></a>
      <details class="mobile-menu"><summary>{x.menu}</summary><nav aria-label={x.menu}>{nav.map(n => <a href={n.href}>{n.label}</a>)}<a href="#instalar">{x.install}</a></nav></details></div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container"><div class="footer-inner"><div class="footer-brand"><a class="brand" href={home}><img src="/logo.svg" alt="" width="28" height="28" />pyahu<span class="brand-product">cli</span></a><p>{t.footer.tagline}</p></div><nav class="footer-links" aria-label={t.footer.links.docs}><a href={docs}>{t.footer.links.docs}</a><a href={`${docs}/instalacao`}>{t.footer.links.install}</a><a href="https://github.com/pyahu/cli">GitHub<Icon name="arrow" size={15} /></a><a href={platform}>{x.platform}<Icon name="arrow" size={15} /></a></nav></div><p class="footer-legal">© {new Date().getFullYear()} Pyahu · Community</p></footer>
  </body>
</html>
