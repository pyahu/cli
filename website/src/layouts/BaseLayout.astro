---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { ui, experience } from "../i18n/landing";
interface Props { title?: string; description?: string; current?: "home" | "docs"; }
const t = ui.en; const x = experience.en;
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const home = "/";
const docs = "/docs";
const platform = "https://pyahu.io";
const canonical = new URL(home, "https://cli.pyahu.io");
const nav: Array<{ href: string; label: string; external?: boolean; icon?: "github" }> = [
  { href: "#services", label: x.services },
  { href: "#quickstart", label: x.workflow },
  { href: docs, label: t.nav.docs },
  { href: "https://github.com/pyahu/cli", label: "GitHub", external: true, icon: "github" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} /><meta name="theme-color" content="#03070d" /><title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <meta property="og:image" content="/pyahu-terminal.svg" /><meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header container" id="top">
      <a class="brand" href={home} aria-label="Pyahu CLI"><img src="/logo.svg" alt="" width="34" height="34" /><span>pyahu<span class="brand-divider">/</span><span class="brand-product">cli</span></span></a>
      <nav class="desktop-nav" aria-label="Pyahu CLI">{nav.map(n => <a href={n.href} target={n.external ? "_blank" : undefined} rel={n.external ? "noreferrer" : undefined}>{n.icon && <Icon name={n.icon} size={16} />}{n.label}</a>)}</nav>
      <div class="header-actions"><a class="nav-cta" href="#install">{x.install}<Icon name="arrow" size={16} /></a>
      <details class="mobile-menu"><summary>{x.menu}</summary><nav aria-label={x.menu}>{nav.map(n => <a href={n.href} target={n.external ? "_blank" : undefined} rel={n.external ? "noreferrer" : undefined}>{n.icon && <Icon name={n.icon} size={16} />}{n.label}</a>)}<a href="#install">{x.install}</a></nav></details></div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container"><div class="footer-inner"><div class="footer-brand"><a class="brand" href={home}><img src="/logo.svg" alt="" width="28" height="28" />pyahu<span class="brand-product">cli</span></a><p>{t.footer.tagline}</p></div><nav class="footer-links" aria-label={t.footer.links.docs}><a href={docs}>{t.footer.links.docs}</a><a href={`${docs}/installation`}>{t.footer.links.install}</a><a href="https://github.com/pyahu/cli">GitHub<Icon name="arrow" size={15} /></a><a href={platform}>{x.platform}<Icon name="arrow" size={15} /></a></nav></div><p class="footer-legal">© {new Date().getFullYear()} Pyahu · Community</p></footer>
  </body>
</html>
